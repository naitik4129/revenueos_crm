# Northbeam CRM — root environment configuration, used by `docker compose`.
# Copy to .env and fill in real values. Never commit .env.
#
# This file covers ONLY what compose.yaml itself reads. The frontend and
# backend each have their own .env for running outside Docker — see
# Frontend/.env.example and Backend/.env.example for the full variable list
# (Supabase, database, SMTP, WhatsApp, etc.).

# Host port the frontend container is published on (container always listens
# on 8080 internally — see Frontend/nginx.conf).
FRONTEND_PORT=8080

# Baked into the frontend's static build at `docker compose build` time (Vite
# embeds these into the bundle — see Frontend/Dockerfile's build args). Same
# values as Frontend/.env.example's VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL the built frontend calls for the Backend API. If you're only
# running the frontend via this compose file (the backend runs elsewhere, or
# via `npm run dev` on the host), point this at wherever that backend is
# actually reachable from a browser.
VITE_API_BASE_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Backend service (see Backend/.env.example for the full variable list —
# these are just what compose.yaml itself needs to start the API container).
# ---------------------------------------------------------------------------

# Host port the backend container is published on (container listens on 8787
# internally, matching Backend/src/env.ts's default PORT).
BACKEND_PORT=8787

# Comma-separated list of origins allowed to call the API. Must include
# wherever the frontend is actually served from.
CORS_ORIGINS=http://localhost:8080

# Same Supabase Postgres connection string / project as above, using a role
# that bypasses RLS. See Backend/.env.example for details.
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
