# Northbeam CRM — root environment configuration, used by `docker compose`.
# Copy to .env and fill in real values. Never commit .env.
#
# This file covers ONLY what compose.yaml itself reads. The frontend and
# backend each have their own .env for running outside Docker — see
# Frontend/.env.example and Backend/.env.example for the full variable list
# (Supabase, database, SMTP, WhatsApp, etc.).

# Host port the frontend container is published on (container always listens
# on 8080 internally — see Frontend/nginx.conf).
FRONTEND_PORT=8080

# Baked into the frontend's static build at `docker compose build` time (Vite
# embeds these into the bundle — see Frontend/Dockerfile's build args). Same
# values as Frontend/.env.example's VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL the built frontend calls for the Backend API. If you're only
# running the frontend via this compose file (the backend runs elsewhere, or
# via `npm run dev` on the host), point this at wherever that backend is
# actually reachable from a browser.
VITE_API_BASE_URL=http://localhost:8787
