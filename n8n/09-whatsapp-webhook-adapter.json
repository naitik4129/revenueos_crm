{
  "name": "09 - WhatsApp Provider Webhook Adapter",
  "nodes": [
    {
      "parameters": {
        "httpMethod": ["GET", "POST"],
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b6f1a009-0001-4a00-8000-000000000001",
      "name": "WhatsApp Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1400, 300],
      "webhookId": "b6f1a009-webhook-whatsapp-inbound",
      "notes": "Meta Cloud API (and similar providers) send a GET to verify webhook ownership (hub.mode/hub.verify_token/hub.challenge) and POST for real message events, on the same URL. If your installed n8n version's Webhook node does not accept an httpMethod array, use two Webhook nodes on the same path instead — one set to GET, one to POST — see n8n/README.md."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "is-verification-cond",
              "leftValue": "={{ $json.query && $json.query['hub.mode'] === 'subscribe' }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a009-0001-4a00-8000-000000000002",
      "name": "Is Verification Handshake?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1180, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Meta requires you to configure the SAME verify token in the Meta App\n// dashboard and here. It is a setup/ownership token, not a request\n// signing secret — replace the placeholder before going live (see\n// n8n/README.md 'Providers').\nconst EXPECTED_VERIFY_TOKEN = '__WHATSAPP_VERIFY_TOKEN__';\nconst query = $input.first().json.query || {};\nconst matched = query['hub.verify_token'] === EXPECTED_VERIFY_TOKEN;\nreturn [{ json: { matched, challenge: query['hub.challenge'] || '' } }];"
      },
      "id": "b6f1a009-0001-4a00-8000-000000000003",
      "name": "Check Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 160]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "token-valid-cond",
              "leftValue": "={{ $json.matched }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a009-0001-4a00-8000-000000000004",
      "name": "Token Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-740, 160]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": { "responseCode": 200 }
      },
      "id": "b6f1a009-0001-4a00-8000-000000000005",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-520, 60]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": { "responseCode": 403 }
      },
      "id": "b6f1a009-0001-4a00-8000-000000000006",
      "name": "Respond Forbidden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-520, 260]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// PLACEHOLDER normalizer for Meta WhatsApp Cloud API's message-event\n// payload shape — see n8n/README.md 'Providers'. Adjust if you use a\n// different WhatsApp BSP/provider; the output shape is the only contract\n// Workflow 07 needs.\nconst body = $input.first().json.body || {};\nconst value = body.entry?.[0]?.changes?.[0]?.value;\nconst message = value?.messages?.[0];\n\nif (!message) {\n  // Delivery/status callbacks (sent, delivered, read) carry no message —\n  // pass through a minimal, harmless event; Workflow 07 will simply find\n  // no matching content worth invalidating anything over.\n  return [{\n    json: {\n      channel: 'whatsapp',\n      fromAddress: value?.statuses?.[0]?.recipient_id || '',\n      providerMessageId: value?.statuses?.[0]?.id,\n      occurredAt: new Date().toISOString(),\n      summary: '[status update, no message content]',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    channel: 'whatsapp',\n    fromAddress: message.from,\n    providerMessageId: message.id,\n    occurredAt: message.timestamp ? new Date(Number(message.timestamp) * 1000).toISOString() : new Date().toISOString(),\n    summary: message.text?.body || `[${message.type} message]`,\n  },\n}];"
      },
      "id": "b6f1a009-0001-4a00-8000-000000000007",
      "name": "Normalize WhatsApp Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 460]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "07 - Generic Inbound Communication Handler"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a009-0001-4a00-8000-000000000008",
      "name": "Handle Inbound Event",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-740, 460]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": { "responseCode": 200 }
      },
      "id": "b6f1a009-0001-4a00-8000-000000000009",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [-520, 460]
    }
  ],
  "connections": {
