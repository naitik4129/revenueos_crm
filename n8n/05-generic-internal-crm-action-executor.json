{
  "name": "05 - Generic Internal CRM Action Executor",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b6f1a005-0001-4a00-8000-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-900, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { backendBaseUrl: \"__NORTHBEAM_BACKEND_BASE_URL__\" } }];"
      },
      "id": "b6f1a005-0001-4a00-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/v1/automation/actions/{{ $('Execute Workflow Trigger').item.json.action.id }}/execute-internal",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 20000 }
      },
      "id": "b6f1a005-0001-4a00-8000-000000000003",
      "name": "Execute Internal Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-460, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Northbeam Backend Service Key"
        }
      },
      "notes": "create_call_task / create_follow_up_task / change_lead_stage / stop_workflow are performed entirely by the backend (business rules, task/stage validation, progression) — this node NEVER reimplements that logic, it only calls the backend operation and reports the HTTP outcome."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "succeeded-cond",
              "leftValue": "={{ $json.error === undefined }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a005-0001-4a00-8000-000000000004",
      "name": "Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const actionId = $('Execute Workflow Trigger').item.json.action.id;\nconst res = $input.first().json;\nreturn [{\n  json: {\n    actionId,\n    outcome: 'failure',\n    error: typeof res.error === 'string' ? res.error : JSON.stringify(res.error),\n    retryable: true,\n  },\n}];"
      },
      "id": "b6f1a005-0001-4a00-8000-000000000005",
      "name": "Build Failure Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 460]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "06 - Workflow Result / Progression Handler"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a005-0001-4a00-8000-000000000006",
      "name": "Report Result",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [200, 460],
      "notes": "Only reached on failure — on success the backend's /execute-internal call already completed the action AND advanced the run in one transaction, so there is nothing left to report."
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Execute Internal Action", "type": "main", "index": 0 }]] },
    "Execute Internal Action": { "main": [[{ "node": "Succeeded?", "type": "main", "index": 0 }]] },
    "Succeeded?": {
      "main": [
        [],
        [{ "node": "Build Failure Payload", "type": "main", "index": 0 }]
      ]
    },
    "Build Failure Payload": { "main": [[{ "node": "Report Result", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
