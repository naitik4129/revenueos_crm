# Northbeam CRM — self-hosted n8n instance configuration.
# Copy to .env (or set as real environment variables / container env for
# your n8n deployment) and fill in real values. Never commit the real file.
#
# IMPORTANT — what does NOT belong here: the backend base URL and the
# backend service key are deliberately NOT read via n8n environment
# variables inside the workflows themselves. Self-hosted n8n now blocks
# $env access in node expressions by default (N8N_BLOCK_ENV_ACCESS_IN_NODE
# defaults to true as of n8n v2.0), so this project instead configures
# those two values as an n8n Credential (the backend service key) and a
# per-workflow Config node placeholder (the backend base URL) — see
# n8n/README.md §4. The variables below are n8n's OWN process-level
# configuration (how n8n itself runs), which is a different, unrelated
# layer.

# --- Identity / reverse proxy -------------------------------------------
# How n8n constructs its own webhook URLs (used by Workflows 08 and 09) and
# the editor's base URL. Set these to match whatever's in front of n8n
# (reverse proxy, load balancer) — get this wrong and your ESP/WhatsApp
# provider's webhook calls to 08/09 will never reach n8n.
N8N_HOST=n8n.your-domain.com
N8N_PROTOCOL=https
N8N_PORT=5678
# Full externally-reachable base URL for webhooks. If unset, n8n derives it
# from N8N_PROTOCOL/N8N_HOST/N8N_PORT — set it explicitly when n8n sits
# behind a reverse proxy/CDN so the derived URL wouldn't be correct on its
# own (e.g. proxy terminates TLS, or forwards a different external port).
WEBHOOK_URL=https://n8n.your-domain.com/

# --- Credential encryption -----------------------------------------------
# Encrypts every credential n8n stores at rest (including the "Northbeam
# Backend Service Key", "Email Provider API Key", etc. from n8n/README.md
# §4.2). n8n generates one automatically on first start if unset, but for
# a real deployment set it explicitly and BACK IT UP — losing it makes
# every stored credential unrecoverable and every one of them (all 4 in
# this project) has to be re-entered by hand. Generate with:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-random-64-char-hex-secret

# --- Timezone --------------------------------------------------------------
# Used by Workflow 01's Schedule Trigger and by timestamp display in the
# n8n UI/logs. The actual business delay math (delay_days -> scheduled_for)
# happens in the backend using timestamptz, so this mainly affects when the
# minute-tick fires and how times are shown, not correctness of delays.
GENERIC_TIMEZONE=Asia/Kolkata

# --- Security (leave at the secure default) --------------------------------
# Blocks $env access in node expressions and the Code node. This project's
# workflows never rely on $env (see note above), so the default (true) is
# fine as-is — do not set this to false just to make Config nodes simpler;
# it would weaken every other workflow on this n8n instance too.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# --- Execution / scaling (optional — defaults are fine for a small team) ---
# Uncomment and tune only if lead/action volume grows enough to need it.
# See n8n/README.md §10 and n8n's queue-mode docs before changing these.
# EXECUTIONS_MODE=queue
# N8N_CONCURRENCY_PRODUCTION_LIMIT=10

# --- n8n's own metadata storage ---------------------------------------------
# This is n8n's internal database (workflow/credential/execution storage) —
# completely separate from the Northbeam CRM's Supabase Postgres database,
# which n8n never connects to directly (it only calls Backend/'s HTTP API).
# Defaults to a local SQLite file if unset, which is fine for a single-node
# deployment; for production/queue-mode, point n8n at its own Postgres
# instance (not the CRM's) per n8n's hosting docs:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=replace-with-a-real-password
