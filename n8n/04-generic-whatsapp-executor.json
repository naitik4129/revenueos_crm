      },
      "id": "b6f1a004-0001-4a00-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-980, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "has-template-cond",
              "leftValue": "={{ $('Execute Workflow Trigger').item.json.template !== null && $('Execute Workflow Trigger').item.json.template !== undefined }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a004-0001-4a00-8000-000000000003",
      "name": "Has Template?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-760, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const actionId = $('Execute Workflow Trigger').item.json.action.id;\nreturn [{\n  json: {\n    actionId,\n    outcome: 'failure',\n    error: 'No active WhatsApp template resolved for this step.',\n    retryable: false,\n  },\n}];"
      },
      "id": "b6f1a004-0001-4a00-8000-000000000004",
      "name": "Build Failure Payload (No Template)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 460]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// WhatsApp templates have no subject — only a body. Same {{lead.field}}\n// token convention as the email executor (n8n/03); keep the two in sync.\nconst ctx = $('Execute Workflow Trigger').item.json;\nconst lead = ctx.lead;\nconst variables = {\n  'lead.firstName': lead.firstName || '',\n  'lead.lastName': lead.lastName || '',\n  'lead.company': lead.company || '',\n  'lead.ownerName': lead.ownerName || '',\n};\n\nfunction render(text) {\n  if (!text) return '';\n  let out = text;\n  for (const [token, value] of Object.entries(variables)) {\n    out = out.split(`{{${token}}}`).join(value);\n  }\n  return out;\n}\n\nreturn [{\n  json: {\n    to: lead.phone,\n    body: render(ctx.template.body || ''),\n  },\n}];"
      },
      "id": "b6f1a004-0001-4a00-8000-000000000005",
      "name": "Render WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "__WHATSAPP_PROVIDER_SEND_URL__",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.to, body: $json.body }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 20000 }
      },
      "id": "b6f1a004-0001-4a00-8000-000000000006",
      "name": "Send WhatsApp via Provider",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-320, 200],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "WhatsApp Provider API Key"
        }
      },
      "notes": "PLACEHOLDER integration point — see n8n/README.md 'Providers'. Replace with your actual WhatsApp Business API call (e.g. Meta Cloud API) or swap for a native n8n WhatsApp node. The rest of this workflow does not need to change either way."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const actionId = $('Execute Workflow Trigger').item.json.action.id;\nconst res = $input.first().json;\nconst failed = res && res.error !== undefined;\n\nif (failed) {\n  return [{\n    json: {\n      actionId,\n      outcome: 'failure',\n      error: typeof res.error === 'string' ? res.error : JSON.stringify(res.error),\n      retryable: true,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    actionId,\n    outcome: 'success',\n    providerMessageId: res.messages?.[0]?.id || res.id || undefined,\n    providerResponse: res,\n  },\n}];"
      },
      "id": "b6f1a004-0001-4a00-8000-000000000007",
      "name": "Build Result Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 200]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "06 - Workflow Result / Progression Handler"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a004-0001-4a00-8000-000000000008",
      "name": "Report Result",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [120, 300]
    }
  ],
