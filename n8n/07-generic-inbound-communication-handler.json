{
  "name": "07 - Generic Inbound Communication Handler",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b6f1a007-0001-4a00-8000-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1400, 300],
      "notes": "Receives a normalized event from Workflow 08 or 09: { leadId?, channel: 'email'|'whatsapp', fromAddress, providerMessageId?, occurredAt?, summary }."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { backendBaseUrl: \"__NORTHBEAM_BACKEND_BASE_URL__\" } }];"
      },
      "id": "b6f1a007-0001-4a00-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "leadid-known-cond",
              "leftValue": "={{ !!$('Execute Workflow Trigger').item.json.leadId }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a007-0001-4a00-8000-000000000003",
      "name": "Lead Id Known?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-960, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { leadId: $('Execute Workflow Trigger').item.json.leadId } }];"
      },
      "id": "b6f1a007-0001-4a00-8000-000000000004",
      "name": "Passthrough Lead Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-740, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/v1/automation/leads/lookup",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $('Execute Workflow Trigger').item.json.channel === 'email' ? $('Execute Workflow Trigger').item.json.fromAddress : '' }}"
            },
            {
              "name": "phone",
              "value": "={{ $('Execute Workflow Trigger').item.json.channel === 'whatsapp' ? $('Execute Workflow Trigger').item.json.fromAddress : '' }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "b6f1a007-0001-4a00-8000-000000000005",
      "name": "Lookup Lead By Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-740, 420],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Northbeam Backend Service Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const matches = $input.first().json.data ?? [];\nreturn [{ json: { leadId: matches[0]?.id ?? null } }];"
      },
      "id": "b6f1a007-0001-4a00-8000-000000000006",
      "name": "Resolve Lead Id From Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-520, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "lead-resolved-cond",
              "leftValue": "={{ !!$json.leadId }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a007-0001-4a00-8000-000000000007",
      "name": "Lead Resolved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/v1/automation/inbound-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ leadId: $json.leadId, channel: $('Execute Workflow Trigger').item.json.channel, providerMessageId: $('Execute Workflow Trigger').item.json.providerMessageId, occurredAt: $('Execute Workflow Trigger').item.json.occurredAt, summary: $('Execute Workflow Trigger').item.json.summary }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "b6f1a007-0001-4a00-8000-000000000008",
      "name": "Post Inbound Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 220],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Northbeam Backend Service Key"
        }
      },
      "notes": "Backend applies all business logic here: response_state, timeline entry, and invalidating stale queued nurture sends of the same channel (see Backend/src/services/automation.service.ts recordInboundEvent). This workflow never decides that itself."
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Lead Id Known?", "type": "main", "index": 0 }]] },
    "Lead Id Known?": {
      "main": [
        [{ "node": "Passthrough Lead Id", "type": "main", "index": 0 }],
        [{ "node": "Lookup Lead By Contact", "type": "main", "index": 0 }]
      ]
    },
    "Passthrough Lead Id": { "main": [[{ "node": "Lead Resolved?", "type": "main", "index": 0 }]] },
    "Lookup Lead By Contact": { "main": [[{ "node": "Resolve Lead Id From Lookup", "type": "main", "index": 0 }]] },
    "Resolve Lead Id From Lookup": { "main": [[{ "node": "Lead Resolved?", "type": "main", "index": 0 }]] },
    "Lead Resolved?": {
      "main": [
        [{ "node": "Post Inbound Event", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
