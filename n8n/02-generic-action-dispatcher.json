{
  "name": "02 - Generic Action Dispatcher",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b6f1a002-0001-4a00-8000-000000000001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-1120, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { backendBaseUrl: \"__NORTHBEAM_BACKEND_BASE_URL__\" } }];"
      },
      "id": "b6f1a002-0001-4a00-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/v1/automation/actions/{{ $('Execute Workflow Trigger').item.json.action.id }}/context",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b6f1a002-0001-4a00-8000-000000000003",
      "name": "Refresh Eligibility",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Northbeam Backend Service Key"
        }
      },
      "notes": "This is the mandatory pre-execution revalidation: lead/run state can change between claim (Workflow 01) and dispatch. $json below is now the FRESH ActionContext."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "eligible-cond",
              "leftValue": "={{ $json.eligibility.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a002-0001-4a00-8000-000000000004",
      "name": "Eligible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.backendBaseUrl }}/api/v1/automation/actions/{{ $json.action.id }}/skip",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reason: $json.eligibility.reason || 'Ineligible at dispatch time.' }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "b6f1a002-0001-4a00-8000-000000000005",
      "name": "Skip Ineligible Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 500],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Northbeam Backend Service Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "is-email-cond",
              "leftValue": "={{ $json.action.actionType }}",
              "rightValue": "send_email",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a002-0001-4a00-8000-000000000006",
      "name": "Is Send Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-220, 160]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "03 - Generic Email Executor"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a002-0001-4a00-8000-000000000007",
      "name": "Execute Email Executor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [0, 60]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "is-whatsapp-cond",
              "leftValue": "={{ $json.action.actionType }}",
              "rightValue": "send_whatsapp",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6f1a002-0001-4a00-8000-000000000008",
      "name": "Is Send WhatsApp?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [0, 260]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "04 - Generic WhatsApp Executor"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a002-0001-4a00-8000-000000000009",
      "name": "Execute WhatsApp Executor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [220, 160]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "05 - Generic Internal CRM Action Executor"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "id": "b6f1a002-0001-4a00-8000-00000000000a",
      "name": "Execute Internal CRM Action Executor",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [220, 380],
      "notes": "Fallback branch: any action_type that is neither send_email nor send_whatsapp (create_call_task, create_follow_up_task, change_lead_stage, stop_workflow, or any future internal action type) routes here. Adding a new CRM business workflow never requires touching this dispatcher."
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Refresh Eligibility", "type": "main", "index": 0 }]] },
    "Refresh Eligibility": { "main": [[{ "node": "Eligible?", "type": "main", "index": 0 }]] },
    "Eligible?": {
      "main": [
        [{ "node": "Is Send Email?", "type": "main", "index": 0 }],
        [{ "node": "Skip Ineligible Action", "type": "main", "index": 0 }]
      ]
    },
    "Is Send Email?": {
      "main": [
        [{ "node": "Execute Email Executor", "type": "main", "index": 0 }],
        [{ "node": "Is Send WhatsApp?", "type": "main", "index": 0 }]
      ]
    },
    "Is Send WhatsApp?": {
      "main": [
        [{ "node": "Execute WhatsApp Executor", "type": "main", "index": 0 }],
        [{ "node": "Execute Internal CRM Action Executor", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
