# Northbeam CRM frontend — environment configuration.
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# All three are OPTIONAL. Leave them unset to keep running the app exactly
# as before (pure mock data, no login wall) — see src/lib/supabase-client.ts
# and routes/__root.tsx's AuthGate. Set them once you want real Supabase
# Auth + the real Backend/ service instead of mock data.

# Supabase project (same project the Backend/ service and
# Supabase/migrations/001_initial_migration.sql point at). Only the PUBLIC
# anon key belongs here — never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Backend/ service (see Backend/README.md).
VITE_API_BASE_URL=http://localhost:8787
