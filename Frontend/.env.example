# MOTM Flow frontend - required environment configuration.
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# All three values are required. Missing or invalid configuration produces a
# visible configuration error; the application never falls back to demo data.

# Supabase project used for authentication. Only the public anon key belongs
# in the frontend; never expose the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Backend service (see Backend/README.md).
VITE_API_BASE_URL=http://localhost:8787
