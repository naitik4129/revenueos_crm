{
  "name": "northbeam-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "demo": "node --env-file=demo/demo.env --import tsx demo/start.ts",
    "load": "tsx load/run.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "baileys": "7.0.0-rc14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^176.0.0",
    "helmet": "^7.1.0",
    "libphonenumber-js": "1.12.16",
    "multer": "^2.3.0",
    "nodemailer": "7.0.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "6.0.3",
    "eslint": "^9.32.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}
