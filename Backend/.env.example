# Northbeam CRM backend — environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# HTTP server
PORT=8787
# Comma-separated list of origins allowed to call this API (the frontend's
# dev server and/or deployed URL). Example: http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Postgres connection string for the Supabase project's database, using a
# role that BYPASSES Row Level Security (the "postgres" role connection
# string from Supabase Project Settings -> Database -> Connection string,
# or the Session Pooler string). RLS stays enabled on every table as
# defense-in-depth for any other client that connects directly; this
# backend is the trusted service that enforces authorization in code
# instead (see src/authMiddleware.ts), the same way Supabase's own
# service_role key does over PostgREST.
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and service role key, used ONLY to verify the
# access token a request presents (supabase.auth.getUser(token)) so we
# know which authenticated salesperson is calling. Never expose the
# service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# development | production — affects logging verbosity and error detail.
NODE_ENV=development

# Shared secret the n8n automation executor sends as the `X-Automation-Key`
# header to call the /api/v1/automation/* routes (see
# src/serviceAuthMiddleware.ts and n8n/README.md). This is a completely
# separate trust boundary from salesperson auth above — n8n never gets a
# Supabase session/user token, and this key unlocks nothing outside
# /api/v1/automation. Generate a real value with, e.g.:
#   openssl rand -hex 32
# Configure the same value in n8n as the "Northbeam Backend Service Key"
# credential (Header Auth: name X-Automation-Key). Never commit the real
# value, and never reuse it for anything else.
N8N_SERVICE_API_KEY=replace-with-a-random-64-char-hex-secret-min-32-chars

# OPTIONAL — this is how the backend talks TO n8n (the reverse direction
# of the pair above). Everything in n8n/README.md works with these unset:
# n8n's Workflow 01 polls /automation/due-actions/claim every minute
# regardless, and that poll is the real source of truth. Setting these two
# just lets the backend give n8n a nudge the instant it creates a
# scheduled_action that's due immediately (e.g. a lead is manually
# enrolled, or a call outcome auto-enrolls one with a same-day first step)
# instead of waiting up to ~60s for the next poll. See
# src/services/n8nWake.ts. Leave both unset in dev if you don't need the
# faster turnaround.
#
# Base webhook URL of your n8n instance's "wake" endpoint (Workflow 01's
# second trigger, alongside its Schedule Trigger):
N8N_WAKE_WEBHOOK_URL=https://your-n8n-host/webhook/wake-due-actions
# Shared secret sent as the `X-Wake-Secret` header so n8n's webhook can
# verify the call really came from this backend (checked by n8n's own
# "Northbeam Wake Webhook Secret" credential — see n8n/README.md §6).
# Generate with: openssl rand -hex 32
N8N_WAKE_WEBHOOK_SECRET=replace-with-a-random-64-char-hex-secret
