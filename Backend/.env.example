# Northbeam CRM backend — environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# HTTP server
PORT=8787
# Comma-separated list of origins allowed to call this API (the frontend's
# dev server and/or deployed URL). Example: http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Postgres connection string for the shared RevenueOSDatabase project, as the
# crm_app role (created by Supabase/migrations/000_platform_grants.sql; it
# bypasses RLS and has rights on schema crm only). Through the Supabase pooler
# the user name is crm_app.<project_ref>. RLS stays on for every crm table with
# no policies; this backend enforces access in code (src/authMiddleware.ts).
DATABASE_URL=postgres://crm_app.your-project-ref:password@your-pooler-host:5432/postgres

# Supabase project URL and service role key, used ONLY to verify the
# access token a request presents (supabase.auth.getUser(token)) so we
# know which authenticated salesperson is calling. Never expose the
# service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for database integration secrets, Baileys auth keys, QR values,
# and retry payloads. Generate once with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# development | production — affects logging verbosity and error detail.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Google Calendar "Connect" button (one shared OAuth app for all workspaces).
# Create the OAuth client once in Google Cloud Console (type: Web application),
# then set all three values together. Leave all blank to make every workspace
# enter its own client credentials instead.
# The redirect URI must match EXACTLY what is registered in Google Cloud:
#   <public backend URL>/api/v1/connections/google-calendar/oauth/callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local example: http://localhost:8787/api/v1/connections/google-calendar/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Outbound send (src/worker.ts + src/providers/*).
# ---------------------------------------------------------------------------

# Optional fallback until a workspace saves its own email connection
# (Resend or TLS/STARTTLS SMTP, encrypted) on the Settings page.
RESEND_API_KEY=
SMTP_FROM_NAME=MOTM Technologies
SMTP_FROM_ADDRESS=

# src/worker.ts poll loop tuning. Defaults are fine for most setups.
WORKER_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
# When true, the worker renders and logs each message instead of actually
# sending it (still advances the run, as if the send succeeded) — a safe way
# to rehearse a workflow's full step progression before going live.
WORKER_DRY_RUN=false
