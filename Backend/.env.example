# Northbeam CRM backend — environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# HTTP server
PORT=8787
# Comma-separated list of origins allowed to call this API (the frontend's
# dev server and/or deployed URL). Example: http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Postgres connection string for the Supabase project's database, using a
# role that BYPASSES Row Level Security (the "postgres" role connection
# string from Supabase Project Settings -> Database -> Connection string,
# or the Session Pooler string). RLS stays enabled on every table as
# defense-in-depth for any other client that connects directly; this
# backend is the trusted service that enforces authorization in code
# instead (see src/authMiddleware.ts), the same way Supabase's own
# service_role key does over PostgREST.
DATABASE_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and service role key, used ONLY to verify the
# access token a request presents (supabase.auth.getUser(token)) so we
# know which authenticated salesperson is calling. Never expose the
# service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# development | production — affects logging verbosity and error detail.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Outbound send (src/worker.ts + src/providers/*) — REQUIRED for the WORKER
# process only (validated separately by src/workerEnv.ts). This is what
# actually delivers nurture-workflow messages. `npm run worker`/`worker:dev`
# will not start without real values here — but the API server (`npm run
# dev`/`start`) does NOT need them and starts fine without this section.
# ---------------------------------------------------------------------------

# SMTP credentials for send_email workflow steps (src/providers/email.provider.ts).
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=MOTM Technologies
SMTP_FROM_ADDRESS=sales@motm.tech

# Meta WhatsApp Cloud API credentials for send_whatsapp workflow steps
# (src/providers/whatsapp.provider.ts) and inbound reply webhooks
# (src/routes/webhooks.routes.ts). From your Meta app's WhatsApp > API Setup
# page (PHONE_NUMBER_ID, ACCESS_TOKEN) and App Settings > Basic (APP_SECRET).
# WEBHOOK_VERIFY_TOKEN is a value you choose yourself and also enter when
# configuring the webhook in the Meta dashboard.
META_WHATSAPP_API_VERSION=v23.0
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=replace-with-access-token
META_WHATSAPP_APP_SECRET=replace-with-app-secret
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-token-you-choose

# src/worker.ts poll loop tuning. Defaults are fine for most setups.
WORKER_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
# When true, the worker renders and logs each message instead of actually
# sending it (still advances the run, as if the send succeeded) — a safe way
# to rehearse a workflow's full step progression before going live.
WORKER_DRY_RUN=false

# ---------------------------------------------------------------------------
# Optional — external n8n executor (legacy/hybrid path). The in-process
# worker above is the primary automation executor now; everything below is
# unused unless you're specifically running an external n8n instance too.
# ---------------------------------------------------------------------------

# Shared secret an external n8n instance would send as the `X-Automation-Key`
# header to call the /api/v1/automation/* routes (see
# src/serviceAuthMiddleware.ts and n8n/README.md). Leave unset to keep those
# routes locked. Generate a real value with, e.g.:
#   openssl rand -hex 32
N8N_SERVICE_API_KEY=

# OPTIONAL — this is how the backend talks TO n8n (the reverse direction
# of the pair above). Leave both unset if you're not running n8n.
#
# Base webhook URL of your n8n instance's "wake" endpoint (Workflow 01's
# second trigger, alongside its Schedule Trigger):
N8N_WAKE_WEBHOOK_URL=
# Shared secret sent as the `X-Wake-Secret` header so n8n's webhook can
# verify the call really came from this backend (checked by n8n's own
# "Northbeam Wake Webhook Secret" credential — see n8n/README.md §6).
# Generate with: openssl rand -hex 32
N8N_WAKE_WEBHOOK_SECRET=
